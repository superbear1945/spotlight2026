        <mxCell id="legend-text-control" value="回合内固定结算顺序" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="82" y="1840" width="96" height="20" as="geometry"/></mxCell>
