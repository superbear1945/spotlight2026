<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Spotlight/UI/Spotlight.uss?fileID=7433441132597879392&amp;guid=622fd0c24e0a84a428530e1d6ba8c5c9&amp;type=3#Spotlight" />
    <ui:VisualElement name="hud-root" picking-mode="Ignore" class="hud-root">
        <ui:VisualElement name="top-bar" picking-mode="Ignore" class="top-bar">
            <ui:Label name="turn-label" text="第 1 回合 · 玩家行动" class="title-label" />
            <ui:Label name="resource-label" text="资源 0" class="info-label" />
            <ui:Label name="plays-label" text="剩余出牌 5" class="info-label" />
        </ui:VisualElement>
        <!-- 齿轮：位于顶部信息条正下方（回合数下方）。图案是 gear.png（.action-button.menu-button 的背景图），
             点击进入菜单：隐藏战斗界面、显示原有面板与「继续 / 重开 / 退出游戏」。 -->
        <ui:Button name="menu-button" class="action-button menu-button" />
        <ui:VisualElement name="log-panel" picking-mode="Ignore" class="panel log-panel">
            <ui:Label text="对局日志" picking-mode="Ignore" class="section-label" />
            <ui:ScrollView name="log-list" class="log-list">
                <ui:VisualElement name="log-content" picking-mode="Ignore" class="log-content" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="side-panel" picking-mode="Ignore" class="panel side-panel">
            <ui:Label text="Boss 状态" picking-mode="Ignore" class="section-label" />
            <ui:Label name="boss-info-label" picking-mode="Ignore" class="info-label" />
            <ui:Label name="phase-label" picking-mode="Ignore" class="warn-label" />
            <ui:Label text="选中详情" picking-mode="Ignore" class="section-label" />
            <ui:Label name="unit-detail" text="点击手牌、己方单位或己方家进行操作" picking-mode="Ignore" class="detail-label" />
        </ui:VisualElement>
        <!-- 左右详情区：只做信息展示（单选中槽）。左侧为我方选中的卡牌，右侧为敌方选中的卡牌；
             平时为空，选中家时不显示。同时作为后续功能的占位区域。 -->
        <ui:VisualElement name="detail-left" picking-mode="Ignore" class="panel detail-panel detail-panel-left">
            <ui:Label name="detail-left-title" class="detail-title" />
            <ui:Label name="detail-left-body" class="detail-body" />
            <ui:Button name="withdraw-button" text="离场" class="action-button withdraw-button" />
        </ui:VisualElement>
        <ui:VisualElement name="detail-right" picking-mode="Ignore" class="panel detail-panel detail-panel-right">
            <ui:Label name="detail-right-title" class="detail-title" />
            <ui:Label name="detail-right-body" class="detail-body" />
        </ui:VisualElement>
        <ui:VisualElement name="bottom-bar" picking-mode="Ignore" class="bottom-bar">
            <ui:Button name="bomb-deploy-button" text="布置炸弹" class="action-button bomb-button" style="display: none;" />
            <ui:Button name="bomb-skip-button" text="跳过炸弹" class="action-button bomb-button" style="display: none;" />
            <!-- 刷怪卡按钮来自 main 的刷怪技能；结束回合按钮已被改版移入 pile-right，这里不重复声明以免重名。 -->
            <ui:Button name="spawner-deploy-button" text="部署刷怪卡" class="action-button" style="display: none;" />
            <ui:Button name="spawner-skip-button" text="跳过刷怪卡" class="action-button" style="display: none;" />
            <ui:Button name="skip-deploy-button" text="跳过放牌并结束" class="action-button" />
        </ui:VisualElement>
        <!-- 手牌同一行的两侧：左侧墓地计数、右侧抽牌堆计数与结束回合。
             目前只显示计数，保留后续（查看列表）的扩展位置。 -->
        <ui:VisualElement name="pile-left" picking-mode="Ignore" class="panel pile-panel pile-left">
            <ui:Label text="墓地" class="pile-title" />
            <ui:Label name="grave-count" text="0" class="pile-count" />
        </ui:VisualElement>
        <ui:VisualElement name="pile-right" picking-mode="Ignore" class="panel pile-panel pile-right">
            <ui:Label text="抽牌堆" class="pile-title" />
            <!-- 抽牌堆按阶级实时显示剩余张数：开局即为抽牌堆构成，抽牌与洗回后自动跟随。 -->
            <ui:Label name="draw-count-advanced" text="高级 0" class="pile-tier-count" />
            <ui:Label name="draw-count-intermediate" text="中级 0" class="pile-tier-count" />
            <ui:Label name="draw-count-basic" text="初级 0" class="pile-tier-count" />
            <ui:Button name="end-turn-button" text="结束回合" class="action-button" />
        </ui:VisualElement>
        <!-- 齿轮菜单：正中间放「继续」「重开」与「退出游戏」（退出会直接结束本次运行，不再返回对局）；
             「配置/调试」也放在这里，且仍由 DebugSupport.IsDebugAvailable 决定是否出现（正式包不显示）。 -->
        <ui:VisualElement name="menu-overlay" class="overlay">
            <ui:VisualElement picking-mode="Ignore" class="overlay-card">
                <ui:Label text="菜单" class="victory-label" />
                <ui:Button name="menu-resume-button" text="继续" class="action-button" />
                <ui:Button name="menu-deck-select-button" text="选卡" class="action-button" />
                <ui:Button name="menu-restart-button" text="重开" class="action-button" />
                <ui:Button name="menu-quit-button" text="退出游戏" class="action-button menu-quit-button" />
                <ui:Button name="debug-button" text="配置/调试" class="action-button menu-debug-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="error-label" picking-mode="Ignore" class="error-label" />
        <ui:VisualElement name="victory-overlay" picking-mode="Ignore" class="overlay">
            <ui:VisualElement picking-mode="Ignore" class="overlay-card">
                <ui:Label name="victory-label" picking-mode="Ignore" class="victory-label" />
                <ui:Button name="victory-restart-button" text="再来一局" class="action-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 选卡入口的二次确认：中途换卡会重开对局，必须先说清代价。 -->
        <ui:VisualElement name="deck-select-confirm-overlay" class="overlay menu-overlay">
            <ui:VisualElement picking-mode="Ignore" class="overlay-card">
                <ui:Label text="进入选卡？" class="victory-label" />
                <ui:Label text="确认后当前对局将重开，进度不会保留。" class="info-label" />
                <ui:Button name="deck-select-confirm-yes" text="进入选卡" class="action-button" />
                <ui:Button name="deck-select-confirm-no" text="继续当前对局" class="action-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- 携带选择面板：开局前必经；齿轮菜单里的“选卡”复用同一面板。 -->
        <ui:VisualElement name="deck-select-mask" class="cfg-mask deck-select-mask">
            <ui:VisualElement class="cfg-panel deck-select-panel">
                <ui:VisualElement class="cfg-head">
                    <ui:VisualElement class="cfg-head-top">
                        <ui:Label name="deck-select-title" text="携带选择" class="cfg-title" />
                        <ui:VisualElement class="cfg-head-actions">
                            <ui:Button name="deck-select-default-button" text="恢复默认" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="deck-select-error" class="cfg-error" />
                </ui:VisualElement>
                <ui:VisualElement class="cfg-body">
                    <ui:ScrollView name="deck-select-scroll" mode="Vertical" class="cfg-scroll">
                        <ui:Label name="deck-select-hint" class="cfg-note" />
                        <ui:VisualElement name="deck-select-cards" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement class="deck-select-foot">
                    <ui:Label name="deck-select-preview" class="deck-select-preview" />
                    <ui:Button name="deck-select-cancel-button" text="取消" class="action-button" />
                    <ui:Button name="deck-select-apply-button" text="确认并开局" class="action-button primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="modal-overlay" class="overlay modal-overlay" />
        <ui:VisualElement name="debug-panel" class="cfg-mask">
            <ui:VisualElement class="cfg-panel">
                <ui:VisualElement class="cfg-head">
                    <ui:VisualElement class="cfg-head-top">
                        <ui:Label text="⚙ 对局配置" class="cfg-title" />
                        <ui:VisualElement class="cfg-head-actions">
                            <ui:Button name="debug-reset-button" text="恢复默认" />
                            <ui:Button name="debug-close-button" text="关闭" />
                            <ui:Button name="debug-apply-button" text="应用并重开" class="primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="debug-error" class="cfg-error" />
                </ui:VisualElement>
                <ui:VisualElement class="cfg-body">
                    <ui:ScrollView name="debug-scroll" mode="Vertical" class="cfg-scroll">
                        <ui:Label text="修改仅在“应用并重开”后生效。关闭后保留草稿，重新打开可继续编辑。" class="cfg-note" />
                        <ui:VisualElement name="debug-board" />
                        <ui:VisualElement name="debug-home" />
                        <ui:VisualElement name="debug-deck" />
                        <ui:VisualElement name="debug-cards" />
                        <ui:VisualElement name="debug-boss" />
                        <ui:VisualElement name="debug-turn" />
                        <ui:VisualElement name="debug-toggles" />
                        <ui:VisualElement class="cfg-section">
                            <ui:Label text="JSON 导入 / 导出" class="cfg-section-title" />
                            <ui:Label text="cardTypes 声明 category（resource / attack / special）与 stats（名字、生命、攻防、射程、移动、产出、维持费）；rules 声明回合与开关；deck 配置数量清单。" class="cfg-note" />
                            <ui:VisualElement class="cfg-json-actions">
                                <ui:Button name="debug-export-button" text="导出到下方" />
                                <ui:Button name="debug-import-button" text="从下方导入" />
                            </ui:VisualElement>
                            <ui:TextField name="debug-json" multiline="true" class="cfg-json" />
                            <ui:Label name="debug-json-status" class="cfg-note" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
