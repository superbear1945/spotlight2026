/* Spotlight 静态界面样式。
   UI Toolkit 只负责 HUD、信息面板与菜单；棋盘和手牌继续由 UGUI 负责。
   卡牌与棋盘的语义色仍来自 Excel 的 Presentation 表，不在这里复制规则。 */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: rgb(238, 235, 218);
}

/* ── 顶部 HUD ───────────────────────────────────────────────────────── */
.top-hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 150px;
}

.player-status,
.enemy-status,
.turn-status {
    position: absolute;
    top: 4px;
}

.player-status {
    left: 4px;
    width: 330px;
}

.enemy-status {
    right: 4px;
    width: 330px;
    align-items: flex-end;
}

.turn-status {
    left: 50%;
    translate: -50% 0;
    width: 360px;
    align-items: center;
}

.life-frame {
    width: 310px;
    height: 116px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.player-life-frame {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/02_player_info/player_life/player_life_static.png");
}

.enemy-life-frame {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/02_player_info/enemy_life/enemy_life_static.png");
}

.life-value {
    position: absolute;
    top: 40px;
    height: 34px;
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(3, 9, 18, 0.9);
}

.player-life-value {
    left: 96px;
    right: 40px;
    color: rgb(240, 235, 214);
}

.boss-life-value {
    left: 40px;
    right: 96px;
    color: rgb(21, 31, 48);
    -unity-text-outline-width: 0;
}

.resource-chip {
    width: 238px;
    height: 72px;
    margin-top: -24px;
    margin-left: 20px;
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_normal.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.resource-label {
    color: rgb(238, 235, 218);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: -2px;
}

.round-counter {
    width: 118px;
    height: 118px;
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/01_turn/round_counter_blank/round_counter_blank_static.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.round-counter.opponent-turn {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/01_turn/round_counter_opponent_blank/round_counter_opponent_blank_static.png");
}

.round-number-label {
    width: 70px;
    height: 40px;
    margin-top: -2px;
    font-size: 29px;
    color: rgb(240, 235, 214);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(4, 10, 20, 0.95);
}

.title-label {
    margin-top: -21px;
    padding: 4px 18px;
    min-width: 290px;
    font-size: 17px;
    color: rgb(244, 239, 220);
    background-color: rgba(9, 18, 32, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(222, 211, 174, 0.8);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.plays-label {
    margin-top: 4px;
    padding: 3px 12px;
    font-size: 13px;
    color: rgb(235, 150, 62);
    background-color: rgba(9, 18, 32, 0.88);
    -unity-text-align: middle-center;
}

.entry-toolbar {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: -23px;
    margin-right: 16px;
}

.icon-button {
    width: 66px;
    height: 66px;
    margin-left: 2px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.history-button {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/history/history_normal.png");
}
.history-button:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/history/history_hover.png");
}
.history-button:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/history/history_pressed.png");
}
.history-button:disabled {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/history/history_disabled.png");
}
.history-button.log-hidden {
    opacity: 0.62;
}

.settings-button {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/settings/settings_normal.png");
}
.settings-button:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/settings/settings_hover.png");
}
.settings-button:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/settings/settings_pressed.png");
}
.settings-button:disabled {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/03_entry_buttons/settings/settings_disabled.png");
}

/* ── 通用面板与文字 ─────────────────────────────────────────────────── */
.panel {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/06_panels_notices/panel_large/panel_large_static.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    padding: 42px 42px 36px 42px;
}

.log-panel {
    position: absolute;
    left: 8px;
    bottom: 78px;
    width: 410px;
    height: 292px;
}

.log-list {
    flex-grow: 1;
}

.log-list .unity-scroll-view__content-viewport {
    background-color: rgba(5, 12, 22, 0.34);
}

.log-content {
    flex-direction: column;
}

.side-panel {
    position: absolute;
    right: 8px;
    top: 138px;
    width: 410px;
    min-height: 300px;
    max-height: 390px;
}

.info-label {
    font-size: 14px;
    color: rgb(212, 220, 224);
    white-space: normal;
}

.warn-label {
    font-size: 14px;
    color: rgb(238, 151, 62);
    white-space: normal;
    margin-top: 4px;
}

.section-label {
    font-size: 15px;
    color: rgb(238, 235, 218);
    margin-top: 4px;
    margin-bottom: 5px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(227, 143, 55, 0.65);
    -unity-font-style: bold;
}

.detail-label {
    font-size: 13px;
    color: rgb(218, 225, 228);
    white-space: normal;
}

.log-line {
    font-size: 12px;
    color: rgb(205, 215, 222);
    white-space: normal;
    margin-bottom: 3px;
}

/* ── 运行时按钮 ─────────────────────────────────────────────────────── */
.bottom-bar {
    position: absolute;
    left: 4px;
    right: 4px;
    bottom: 2px;
    height: 80px;
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
}

/* 底部按钮条：左移 252px，给同一行的左侧“墓地”计数让位（棋盘与手牌的位置不变）。
   按钮仍然从左往右排列，因此不会与右侧的“抽牌堆 / 结束回合”区域重叠。 */
.bottom-bar {
    position: absolute;
    left: 264px;
    right: 12px;
    bottom: 12px;
    flex-direction: row;
    align-items: flex-end;
    flex-wrap: wrap;
}

.action-button {
    min-width: 176px;
    height: 66px;
    margin-right: 2px;
    padding: 0 34px;
    font-size: 14px;
    color: rgb(240, 236, 219);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_normal.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.action-button:hover,
.primary-action:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_hover.png");
}

.action-button:active,
.primary-action:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_pressed.png");
}

.action-button:disabled,
.primary-action:disabled {
    color: rgba(238, 235, 218, 0.55);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_disabled.png");
}

.secondary-action {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_normal.png");
}
.secondary-action:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_hover.png");
}
.secondary-action:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_pressed.png");
}
.secondary-action:disabled {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_disabled.png");
}

.end-turn-button {
    width: 224px;
    min-width: 224px;
    height: 82px;
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/01_turn/end_turn/end_turn_normal.png");
    -unity-background-scale-mode: scale-to-fit;
}
.end-turn-button:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/01_turn/end_turn/end_turn_hover.png");
}
.end-turn-button:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/01_turn/end_turn/end_turn_pressed.png");
}
.end-turn-button:disabled {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/01_turn/end_turn/end_turn_disabled.png");
}

.withdraw-button {
    align-self: flex-start;
    min-width: 154px;
    height: 58px;
    margin-top: 6px;
    margin-right: 0;
}

.bomb-button {
    color: rgb(247, 166, 77);
}

/* ── 提示与结算遮罩 ─────────────────────────────────────────────────── */
.error-label {
    position: absolute;
    left: 50%;
    top: 132px;
    translate: -50% 0;
    width: 700px;
    min-height: 82px;
    padding: 27px 84px;
    font-size: 14px;
    color: rgb(247, 224, 205);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/06_panels_notices/notice/notice_static.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-text-align: middle-center;
    white-space: normal;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.victory-overlay,
.modal-overlay {
    background-color: rgba(1, 5, 12, 0.66);
}

.overlay-card {
    width: 610px;
    min-height: 430px;
    padding: 76px 76px 66px 76px;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/06_panels_notices/panel_large/panel_large_static.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.result-art {
    width: 470px;
    height: 168px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.victory-art {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/07_results/victory/victory_static.png");
}

.defeat-art {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/07_results/defeat/defeat_static.png");
}

.victory-label {
    font-size: 20px;
    color: rgb(242, 235, 211);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: -22px;
    margin-bottom: 4px;
}

.victory-restart-button {
    margin-right: 0;
}

/* ── 对局配置面板（表单式） ────────────────────────────────────────── */
.cfg-mask {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(2, 7, 14, 0.82);
    align-items: flex-start;
    justify-content: center;
    padding: 24px;
}

.cfg-panel {
    width: 880px;
    max-width: 100%;
    max-height: 100%;
    background-color: rgb(10, 19, 32);
    border-width: 1px;
    border-color: rgb(220, 207, 170);
}

.cfg-head {
    flex-direction: column;
    padding: 14px 16px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(214, 126, 45);
    background-color: rgb(14, 28, 46);
}

.cfg-head-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.cfg-title {
    font-size: 16px;
    color: rgb(240, 235, 217);
    -unity-font-style: bold;
}

.cfg-head-actions {
    flex-direction: row;
}

.cfg-head-actions Button {
    margin-left: 4px;
}

.cfg-error {
    color: rgb(246, 119, 100);
    font-size: 12px;
    white-space: normal;
    margin-top: 8px;
    display: none;
}

.cfg-body {
    flex-grow: 1;
    padding: 8px 16px 20px;
}

.cfg-scroll {
    flex-grow: 1;
}

.cfg-section {
    padding: 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(216, 204, 169, 0.28);
}

.cfg-section-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.cfg-section-title {
    font-size: 13.5px;
    color: rgb(237, 229, 205);
    -unity-font-style: bold;
}

.cfg-note {
    font-size: 12px;
    color: rgb(139, 159, 178);
    white-space: normal;
    margin-top: 8px;
}

.cfg-deck-summary {
    font-size: 13px;
    color: rgb(209, 219, 224);
    margin-top: 4px;
}

.cfg-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.cfg-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 190px;
    min-width: 170px;
    margin-right: 10px;
    margin-bottom: 10px;
}

.cfg-field-label {
    font-size: 12.5px;
    color: rgb(171, 185, 194);
    margin-bottom: 4px;
}

.cfg-input {
    font-size: 13px;
    color: rgb(238, 235, 218);
}

.cfg-input .unity-base-field__input,
.cfg-input .unity-text-field__input,
.cfg-input .unity-integer-field__input,
.cfg-input .unity-base-text-field__input {
    background-color: rgb(7, 14, 25);
    border-width: 1px;
    border-color: rgba(229, 218, 180, 0.35);
    padding: 6px 8px;
    color: rgb(238, 235, 218);
}

.cfg-toggle {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.cfg-toggle-label {
    font-size: 13px;
    color: rgb(209, 218, 222);
    margin-left: 8px;
    white-space: normal;
}

.cfg-toggles {
    flex-direction: row;
    flex-wrap: wrap;
}

.cfg-toggles .cfg-toggle {
    flex-grow: 1;
    flex-basis: 280px;
    min-width: 260px;
}

.cfg-card {
    margin-top: 12px;
    padding: 12px;
    border-width: 1px;
    border-color: rgba(229, 218, 180, 0.35);
    background-color: rgba(17, 31, 49, 0.72);
}

.cfg-card-title {
    font-size: 14px;
    color: rgb(242, 237, 219);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.cfg-panel Button {
    min-width: 132px;
    height: 52px;
    padding: 0 28px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_normal.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    color: rgb(240, 235, 218);
    font-size: 13px;
    -unity-text-align: middle-center;
}

.cfg-panel Button:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_hover.png");
}

.cfg-panel Button:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_pressed.png");
}

.cfg-panel Button:disabled {
    color: rgba(238, 235, 218, 0.52);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/secondary/secondary_disabled.png");
}

.cfg-panel Button.primary {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_normal.png");
    -unity-font-style: bold;
}

.cfg-panel Button.primary:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_hover.png");
}

.cfg-panel Button.primary:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_pressed.png");
}

.cfg-panel Button.primary:disabled {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/04_action_buttons/primary/primary_disabled.png");
}

.cfg-json-actions {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 8px;
}

.cfg-json-actions Button {
    margin-right: 4px;
}

.bomb-button { border-bottom-color: rgb(220, 110, 45); border-bottom-width: 2px; }

/* ── 战斗界面（新 UI，默认显示） ──────────────────────────────────────────
   布局预算（与 SpotlightMenu 生成的容器尺寸保持一致，改动请同时改两处）：
   - 棋盘维持现状：x∈[460,1520]、y∈[250,1010]（Canvas 参考分辨率 1920×1080）；
     因此左侧余 460px、右侧余 400px，正好容纳左右详情区（左 420 / 右 380）；
   - 手牌行：左“墓地”240 + 居中手牌 1020 + 右“抽牌堆 / 结束回合”380；
   - 详情区与卡牌计数都只是占位与展示，真正的合法性仍由规则层给出。 */
/* 齿轮按钮：图标按钮，图标来自 Assets/Spotlight/UI/Pictures/gear.png（背景图，不再用文字）。
   为什么 margin: 0：Unity 默认主题的 .unity-button 自带 margin 2px 4px（调试器里看到的 “2px 0px 2px 4px”
   就是它，加上这里原先的 margin-right: 0）。对固定尺寸 + 绝对定位的按钮来说，这些 margin 不会参与任何排版，
   只会把方框顶偏、在四周留一圈点不到的死区，所以全部清零。
   位置只改下面的 left / top（不要在 UXML 里加内联 style：内联样式会盖掉整条规则，同一个按钮就有两个真源）。 */
.action-button.menu-button {
    position: absolute;
    left: 12px;
    top: 61px;
    width: 42px;
    height: 42px;
    margin: 0;
    background-image: url("project://database/Assets/Spotlight/UI/Pictures/gear.png?fileID=2800000&guid=788226b706a331b438a4fa9013f33e42&type=3#gear");
    /* 按比例缩放：以后换成非正方形图标也不会被拉扁。 */
    -unity-background-scale-mode: scale-to-fit;
}

.hud-root .top-hud {
    height: 220px;
}

.hud-root .player-status {
    top: 275px;
    left: 10px;
    width: 330px;
    align-items: flex-start;
}

.hud-root .enemy-status {
    top: 275px;
    right: 10px;
    width: 330px;
    align-items: flex-end;
}

.hud-root .turn-status {
    left: 0;
    right: 0;
    top: 0;
    width: auto;
    height: 220px;
    translate: 0 0;
    align-items: stretch;
}

.hud-root .life-frame {
    width: 290px;
    height: 112px;
}

.hud-root .life-value {
    top: 38px;
    height: 38px;
    font-size: 30px;
}

.hud-root .player-life-value {
    left: 88px;
    right: 38px;
}

.hud-root .boss-life-value {
    left: 38px;
    right: 88px;
}

.hud-root .resource-chip {
    position: relative;
    width: 320px;
    height: 106px;
    margin-top: -38px;
    margin-left: -15px;
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/02_player_info/player_energy/player_energy_static.png");
}

.hud-root .resource-label {
    position: absolute;
    right: 52px;
    top: 37px;
    width: 70px;
    height: 34px;
    margin-top: 0;
    font-size: 25px;
    color: rgb(244, 239, 220);
    -unity-text-align: middle-center;
}

.hud-root .round-counter {
    position: absolute;
    left: 50%;
    top: -14px;
    translate: -50% 0;
    width: 220px;
    height: 220px;
}

.hud-root .round-number-label {
    position: absolute;
    left: 50%;
    top: 91px;
    translate: -50% 0;
    width: 108px;
    height: 68px;
    margin-top: 0;
