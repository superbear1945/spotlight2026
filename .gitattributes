*.jpg  binary
*.jpeg binary
*.gif  binary
*.tga  binary
*.psd  binary
*.tif  binary
*.tiff binary
*.exr  binary
*.hdr  binary
*.bmp  binary

*.fbx  binary
*.obj  binary
*.blend binary
*.dae  binary
*.3ds  binary
*.max  binary
*.ma   binary
*.mb   binary

*.wav  binary
*.mp3  binary
*.ogg  binary
*.aiff binary
*.aif  binary
*.flac binary

*.mp4  binary
*.mov  binary
*.webm binary
*.avi  binary

*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

*.dll  binary
*.so   binary
*.dylib binary
*.a    binary
*.bundle binary
*.apk  binary
*.aab  binary
*.unitypackage binary
*.cubemap binary
*.physicMaterial binary
*.physicsMaterial binary
*.psb   binary

# Unity 二进制/容器型资产（不依赖内容嗅探）
*.bytes binary

# 插件 / 构建产物容器（.gitignore 已排除构建输出，此处兜底）
*.jar   binary
*.aar   binary

# 文档与 Office 文件：均为 zip/OLE 容器，既不可 diff 也不该被当文本处理
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.docx  binary
*.pptx  binary


