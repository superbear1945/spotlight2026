        <mxCell id="legend-text-neutral" value="未超限时直接跳过" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="238" y="1840" width="88" height="20" as="geometry"/></mxCell>
        <mxCell id="legend-line-read" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#2563eb;strokeWidth=2.4;fontColor=#64748b;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="1850" as="sourcePoint"/><mxPoint x="376" y="1850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="legend-text-read" value="胜负检查与结束" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="386" y="1840" width="80" height="20" as="geometry"/></mxCell>
        <mxCell id="legend-line-feedback" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#ef4444;strokeWidth=2.4;fontColor=#64748b;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="486" y="1850" as="sourcePoint"/><mxPoint x="516" y="1850" as="targetPoint"/></mxGeometry></mxCell>
