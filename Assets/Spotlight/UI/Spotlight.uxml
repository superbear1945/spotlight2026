<?xml version="1.0" encoding="utf-8"?>
<!-- 静态界面标记：回合信息、资源、日志、单位详情、按钮、胜负遮罩与调试面板。
     动态的手牌与棋盘使用 UGUI，因此这里只放结构固定的面板；容器默认 picking-mode="Ignore"，
     以免装饰性元素挡住 UGUI 的棋盘点击，只有按钮等交互元素保持默认拾取。 -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Spotlight.uss" />

    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">

        <!-- 顶部信息条 -->
        <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
            <ui:Label name="turn-label" text="第 1 回合 · 玩家行动" class="title-label" />
            <ui:Label name="resource-label" text="资源 0" class="info-label" />
            <ui:Label name="plays-label" text="剩余出牌 5" class="info-label" />
        </ui:VisualElement>

        <!-- 左侧日志 -->
        <ui:VisualElement name="log-panel" class="panel log-panel" picking-mode="Ignore">
            <ui:Label text="对局日志" class="section-label" picking-mode="Ignore" />
            <ui:ScrollView name="log-list" class="log-list">
                <ui:VisualElement name="log-content" class="log-content" picking-mode="Ignore" />
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- 右侧状态 -->
        <ui:VisualElement name="side-panel" class="panel side-panel" picking-mode="Ignore">
            <ui:Label text="Boss 状态" class="section-label" picking-mode="Ignore" />
            <ui:Label name="boss-info-label" text="" class="info-label" picking-mode="Ignore" />
            <ui:Label name="phase-label" text="" class="warn-label" picking-mode="Ignore" />
            <ui:Label text="选中详情" class="section-label" picking-mode="Ignore" />
            <ui:Label name="unit-detail" text="点击手牌、己方单位或己方家进行操作" class="detail-label" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 底部按钮条 -->
        <ui:VisualElement name="bottom-bar" class="bottom-bar" picking-mode="Ignore">
            <ui:Button name="end-turn-button" text="结束回合" class="action-button" />
            <ui:Button name="skip-deploy-button" text="跳过放牌并结束" class="action-button" />
            <ui:Button name="restart-button" text="重开" class="action-button" />
            <ui:Button name="debug-button" text="配置/调试" class="action-button" />
        </ui:VisualElement>

        <!-- 错误与提示 -->
        <ui:Label name="error-label" text="" class="error-label" picking-mode="Ignore" />

        <!-- 胜负遮罩 -->
        <ui:VisualElement name="victory-overlay" class="overlay" picking-mode="Ignore">
            <ui:VisualElement class="overlay-card" picking-mode="Ignore">
                <ui:Label name="victory-label" text="" class="victory-label" picking-mode="Ignore" />
                <ui:Button name="victory-restart-button" text="再来一局" class="action-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 模态遮罩：配置面板打开时挡住棋盘视觉，真正的输入拦截由规则层完成 -->
        <ui:VisualElement name="modal-overlay" class="overlay modal-overlay" />

        <!-- 对局配置面板：表单式逐项编辑，字段分组与既有网页版配置界面保持一致。
             分区骨架固定，逐卡种卡片由 ConfigDebugPanel 在运行时生成。 -->
        <ui:VisualElement name="debug-panel" class="cfg-mask">
            <ui:VisualElement class="cfg-panel">
                <ui:VisualElement class="cfg-head">
                    <ui:VisualElement class="cfg-head-top">
                        <ui:Label text="⚙ 对局配置" class="cfg-title" />
                        <ui:VisualElement class="cfg-head-actions">
                            <ui:Button name="debug-reset-button" text="恢复默认" />
                            <ui:Button name="debug-close-button" text="关闭" />
                            <ui:Button name="debug-apply-button" text="应用并重开" class="primary" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="debug-error" class="cfg-error" />
                </ui:VisualElement>
                <ui:VisualElement class="cfg-body">
                    <ui:ScrollView name="debug-scroll" class="cfg-scroll" mode="Vertical">
                        <ui:Label class="cfg-note" text="修改仅在“应用并重开”后生效。关闭后保留草稿，重新打开可继续编辑。" />
                        <ui:VisualElement name="debug-board" />
                        <ui:VisualElement name="debug-home" />
                        <ui:VisualElement name="debug-deck" />
                        <ui:VisualElement name="debug-cards" />
                        <ui:VisualElement name="debug-boss" />
                        <ui:VisualElement name="debug-turn" />
                        <ui:VisualElement name="debug-toggles" />

                        <ui:VisualElement class="cfg-section">
                            <ui:Label text="JSON 导入 / 导出" class="cfg-section-title" />
                            <ui:Label class="cfg-note" text="cardTypes 声明 category（resource / attack / special）与 stats（名字、生命、攻防、射程、移动、产出、维持费）；rules 声明回合与开关；deck 配置数量清单。" />
                            <ui:VisualElement class="cfg-json-actions">
                                <ui:Button name="debug-export-button" text="导出到下方" />
                                <ui:Button name="debug-import-button" text="从下方导入" />
                            </ui:VisualElement>
                            <ui:TextField name="debug-json" multiline="true" class="cfg-json" />
                            <ui:Label name="debug-json-status" class="cfg-note" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
