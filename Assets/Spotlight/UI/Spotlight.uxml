<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <Style src="project://database/Assets/Spotlight/UI/Spotlight.uss?fileID=7433441132597879392&amp;guid=622fd0c24e0a84a428530e1d6ba8c5c9&amp;type=3#Spotlight" />
  <ui:VisualElement name="hud-root" picking-mode="Ignore" class="hud-root">
    <ui:VisualElement name="top-hud" picking-mode="Ignore" class="top-hud">
      <ui:VisualElement name="player-status" picking-mode="Ignore" class="player-status">
        <ui:Label text="我方" picking-mode="Ignore" class="side-label player-side-label" />
        <ui:VisualElement picking-mode="Ignore" class="life-frame player-life-frame">
          <ui:Label name="player-life-label" text="10" picking-mode="Ignore" class="life-value player-life-value" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="resource-chip">
          <ui:Label name="resource-label" text="0" picking-mode="Ignore" class="resource-label" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement name="turn-status" picking-mode="Ignore" class="turn-status">
        <ui:Button name="end-turn-button" text="" tooltip="结束回合" class="end-turn-button" />
        <ui:VisualElement name="opponent-turn-indicator" picking-mode="Ignore" class="opponent-turn-indicator" style="display: none;" />
        <ui:VisualElement name="round-counter" picking-mode="Ignore" class="round-counter">
          <ui:Label name="round-number-label" text="01" picking-mode="Ignore" class="round-number-label" />
        </ui:VisualElement>
        <ui:Label name="turn-label" text="第 1 回合 · 玩家行动" picking-mode="Ignore" class="title-label" style="display: none;" />
        <ui:Label name="plays-label" text="剩余出牌 5" picking-mode="Ignore" class="plays-label" style="display: none;" />
      </ui:VisualElement>
      <ui:VisualElement name="enemy-status" picking-mode="Ignore" class="enemy-status">
        <ui:Label text="敌方" picking-mode="Ignore" class="side-label enemy-side-label" />
        <ui:VisualElement picking-mode="Ignore" class="life-frame enemy-life-frame">
          <ui:Label name="boss-life-label" text="10" picking-mode="Ignore" class="life-value boss-life-value" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement picking-mode="Ignore" class="entry-toolbar">
        <ui:Button name="pause-button" text="" tooltip="暂停" class="icon-button pause-button entry-first" />
        <ui:Button name="debug-button" text="" tooltip="配置 / 调试" class="icon-button settings-button" />
        <ui:Button name="history-button" text="" tooltip="显示或隐藏对局日志" class="icon-button history-button log-hidden" />
        <ui:Button name="help-button" text="" tooltip="规则帮助" class="icon-button help-button" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="log-panel" picking-mode="Ignore" class="panel log-panel" style="display: none;">
      <ui:Label text="对局日志" picking-mode="Ignore" class="section-label" />
      <ui:ScrollView name="log-list" class="log-list">
        <ui:VisualElement name="log-content" picking-mode="Ignore" class="log-content" />
      </ui:ScrollView>
    </ui:VisualElement>
    <ui:VisualElement name="side-panel" picking-mode="Ignore" class="panel side-panel" style="display: none;">
      <ui:Label text="Boss 状态" picking-mode="Ignore" class="section-label" />
      <ui:Label name="boss-info-label" picking-mode="Ignore" class="info-label" />
      <ui:Label name="phase-label" picking-mode="Ignore" class="warn-label" />
      <ui:Label text="选中详情" picking-mode="Ignore" class="section-label" />
      <ui:Label name="unit-detail" text="点击手牌、己方单位或己方家进行操作" picking-mode="Ignore" class="detail-label" />
      <ui:Button name="withdraw-button" text="离场" class="action-button secondary-action withdraw-button" style="display: none;" />
    </ui:VisualElement>
    <ui:VisualElement name="bottom-bar" picking-mode="Ignore" class="bottom-bar">
      <ui:Button name="bomb-deploy-button" text="布置炸弹" class="action-button primary-action bomb-button" style="display: none;" />
      <ui:Button name="bomb-skip-button" text="跳过炸弹" class="action-button secondary-action bomb-button" style="display: none;" />
      <ui:Button name="spawner-deploy-button" text="部署刷怪卡" class="action-button primary-action" style="display: none;" />
      <ui:Button name="spawner-skip-button" text="跳过刷怪卡" class="action-button secondary-action" style="display: none;" />
      <ui:Button name="skip-deploy-button" text="跳过放牌并结束" class="action-button secondary-action" style="display: none;" />
      <ui:Button name="restart-button" text="重开" class="action-button secondary-action" style="display: none;" />
    </ui:VisualElement>
    <ui:Label name="error-label" picking-mode="Ignore" class="error-label" style="display: none;" />
    <ui:VisualElement name="victory-overlay" picking-mode="Ignore" class="overlay victory-overlay" style="display: none;">
      <ui:VisualElement picking-mode="Ignore" class="overlay-card">
        <ui:VisualElement name="victory-art" picking-mode="Ignore" class="result-art victory-art" style="display: none;" />
        <ui:VisualElement name="defeat-art" picking-mode="Ignore" class="result-art defeat-art" style="display: none;" />
        <ui:Label name="victory-label" picking-mode="Ignore" class="victory-label" />
        <ui:Button name="victory-restart-button" text="再来一局" class="action-button primary-action victory-restart-button" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="modal-overlay" class="overlay modal-overlay" style="display: none;" />
    <ui:VisualElement name="pause-overlay" class="overlay pause-overlay" style="display: none;">
      <ui:VisualElement name="pause-panel" picking-mode="Ignore" class="pause-panel" />
      <ui:Button name="pause-close-button" text="" tooltip="继续战斗" class="pause-close-button" />
      <ui:Button name="pause-continue-button" text="继续战斗" class="pause-menu-button pause-continue-button" />
      <ui:Button name="pause-restart-button" text="重新开始" class="pause-menu-button pause-restart-button" />
      <ui:Button name="pause-exit-button" text="退出战斗" class="pause-menu-button pause-exit-button" />
    </ui:VisualElement>
    <ui:VisualElement name="debug-panel" class="cfg-mask">
      <ui:VisualElement class="cfg-panel">
        <ui:VisualElement class="cfg-head">
          <ui:VisualElement class="cfg-head-top">
            <ui:Label text="⚙ 对局配置" class="cfg-title" />
            <ui:VisualElement class="cfg-head-actions">
              <ui:Button name="debug-reset-button" text="恢复默认" />
              <ui:Button name="debug-close-button" text="关闭" />
              <ui:Button name="debug-apply-button" text="应用并重开" class="primary" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:Label name="debug-error" class="cfg-error" />
        </ui:VisualElement>
        <ui:VisualElement class="cfg-body">
          <ui:ScrollView name="debug-scroll" mode="Vertical" class="cfg-scroll">
            <ui:Label text="修改仅在“应用并重开”后生效。关闭后保留草稿，重新打开可继续编辑。" class="cfg-note" />
            <ui:VisualElement name="debug-board" />
            <ui:VisualElement name="debug-home" />
            <ui:VisualElement name="debug-deck" />
            <ui:VisualElement name="debug-cards" />
            <ui:VisualElement name="debug-boss" />
            <ui:VisualElement name="debug-turn" />
            <ui:VisualElement name="debug-toggles" />
            <ui:VisualElement class="cfg-section">
              <ui:Label text="JSON 导入 / 导出" class="cfg-section-title" />
              <ui:Label text="cardTypes 声明 category（resource / attack / special）与 stats（名字、生命、攻防、射程、移动、产出、维持费）；rules 声明回合与开关；deck 配置数量清单。" class="cfg-note" />
              <ui:VisualElement class="cfg-json-actions">
                <ui:Button name="debug-export-button" text="导出到下方" />
                <ui:Button name="debug-import-button" text="从下方导入" />
              </ui:VisualElement>
              <ui:TextField name="debug-json" multiline="true" class="cfg-json" />
              <ui:Label name="debug-json-status" class="cfg-note" />
            </ui:VisualElement>
          </ui:ScrollView>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>