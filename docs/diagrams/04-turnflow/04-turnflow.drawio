<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="04-turnflow" name="Spotlight 回合与胜负流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1980" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c-player" value="&lt;b&gt;玩家回合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;rules.firstSide = player 时的执行顺序&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dbe5f1;strokeWidth=1.4;dashed=1;dashPattern=1 3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="130" width="520" height="1400" as="geometry"/></mxCell>
        <mxCell id="c-boss" value="&lt;b&gt;Boss 回合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;补齐兵位后逐个行动，然后自动结束&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dbe5f1;strokeWidth=1.4;dashed=1;dashPattern=1 3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="520" height="1400" as="geometry"/></mxCell>
        <mxCell id="n-start" value="&lt;b&gt;回合开始&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;回合号从 1 开始，双方各行动一次后递增&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="200" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-restore" value="&lt;b&gt;恢复行动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;己方单位恢复行动，家恢复移动机会&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="350" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-resource" value="&lt;b&gt;资源结算&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;按开关清零或累积，结算家与场上产出&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="500" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-upkeep" value="&lt;b&gt;按部署顺序支付维持费&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;欠费只禁止行动，不关闭星门部署扩展&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="650" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-draw" value="&lt;b&gt;抽牌&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;抽牌堆耗尽时先洗回墓地再继续抽&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="800" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-operate" value="&lt;b&gt;玩家操作&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;出牌 · 移动 · 攻击 · 互换 · 家移动一格&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="950" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-endturn" value="&lt;b&gt;结束回合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;出牌次数耗尽或主动结束&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="1100" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-limit" value="&lt;b&gt;手牌是否超过上限&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;默认上限 5 张&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;spacingLeft=18;spacingRight=18;" vertex="1" parent="1"><mxGeometry x="180" y="1250" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-discard" value="&lt;b&gt;弃牌至上限&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;完成后才进入对手回合&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="1400" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-note" value="&lt;b&gt;先手顺序与左右镜像&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;firstSide 决定先手方；playerSide 决定家与区域方向&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="440" height="140" as="geometry"/></mxCell>
        <mxCell id="n-boss-restore" value="&lt;b&gt;恢复行动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;Boss 单位恢复行动，忽略资源与维持费&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="950" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-boss-spawn" value="&lt;b&gt;首次部署或到期补兵&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;兵位独立计时，无空位则下次重试&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="1100" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-boss-act" value="&lt;b&gt;按部署顺序逐个行动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;AI 决策或玩家手动操作&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="1250" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-boss-end" value="&lt;b&gt;Boss 回合自动结束&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;手动模式由玩家提交结束&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="1400" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="n-check" value="&lt;b&gt;胜负是否已确定&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;每次行动后检查，确定后停止行动与补兵&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;spacingLeft=18;spacingRight=18;" vertex="1" parent="1"><mxGeometry x="860" y="1580" width="480" height="90" as="geometry"/></mxCell>
        <mxCell id="n-outcome" value="&lt;b&gt;对局结束：胜负或平局&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;停止后续行动与补兵，界面显示结果&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="1740" width="480" height="90" as="geometry"/></mxCell>
        <mxCell id="n-next" value="&lt;b&gt;进入下一回合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;双方各行动一次后回合号递增&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="1740" width="480" height="90" as="geometry"/></mxCell>
        <mxCell id="e-start-restore" value="回合开始" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-start" target="n-restore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-restore-resource" value="恢复完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-restore" target="n-resource"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-resource-upkeep" value="产出先于维持费" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-resource" target="n-upkeep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-upkeep-draw" value="支付后抽牌" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-upkeep" target="n-draw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-draw-operate" value="进入操作阶段" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-draw" target="n-operate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-operate-endturn" value="玩家结束回合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-operate" target="n-endturn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-endturn-limit" value="检查手牌" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-endturn" target="n-limit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-limit-discard" value="超过上限" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-limit" target="n-discard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-limit-boss" value="未超限：直接进入对方回合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#6b7280;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-limit" target="n-boss-restore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-discard-boss" value="弃牌完成后进入对方回合" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-discard" target="n-boss-restore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boss-restore-spawn" value="恢复完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-boss-restore" target="n-boss-spawn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boss-spawn-act" value="补齐兵位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-boss-spawn" target="n-boss-act"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boss-act-end" value="行动完毕" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-boss-act" target="n-boss-end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-boss-end-check" value="检查胜负" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#2563eb;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-boss-end" target="n-check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-check-outcome" value="已确定：对局结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#2563eb;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-check" target="n-outcome"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-check-next" value="未确定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#ef4444;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-check" target="n-next"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-next-start" value="下一回合由先手方重新开始" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#ef4444;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-next" target="n-start"><mxGeometry relative="1" as="geometry"/></mxCell>
