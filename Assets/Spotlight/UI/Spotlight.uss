    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/toggle_on/toggle_on_hover.png");
}

.hud-root .settings-toggle:checked:active .unity-toggle__checkmark {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/toggle_on/toggle_on_pressed.png");
}

.hud-root .settings-toggle:disabled .unity-toggle__checkmark {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/toggle_off/toggle_off_disabled.png");
}

.hud-root .settings-toggle:checked:disabled .unity-toggle__checkmark {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/toggle_on/toggle_on_disabled.png");
}

.hud-root .settings-debug-button {
    font-size: 18px;
    -unity-background-scale-mode: scale-and-crop;
}

.hud-root .utility-actions {
    position: absolute;
    left: 78px;
    right: 78px;
    top: 462px;
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.hud-root .utility-actions .action-button {
    width: 225px;
    height: 60px;
    margin: 0 6px;
    -unity-background-scale-mode: scale-and-crop;
}

.hud-root .help-panel {
    width: 920px;
    height: 613px;
    padding: 0;
}

.hud-root .help-title-row {
    margin: 0;
}

.hud-root .help-panel > .settings-title-row {
    left: 175px;
    right: 175px;
    top: 72px;
    height: 58px;
}

.hud-root .help-title {
    min-width: 190px;
}

.hud-root .help-scroll {
    position: absolute;
    left: 110px;
    right: 104px;
    top: 148px;
    height: 306px;
    margin: 0;
    padding: 0 2px 0 8px;
}

.hud-root .help-scroll .unity-scroll-view__vertical-scroller {
    width: 44px;
    margin-left: 14px;
    translate: -14px 0;
    background-color: rgba(0, 0, 0, 0);
}

.hud-root .help-scroll .unity-scroller__low-button,
.hud-root .help-scroll .unity-scroller__high-button {
    display: none;
}

.hud-root .help-scroll .unity-scroller__slider {
    width: 44px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/scroll_track/scroll_track_static.png");
    -unity-background-scale-mode: scale-and-crop;
}

.hud-root .help-scroll .unity-base-slider__tracker {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hud-root .help-scroll .unity-base-slider__dragger-border {
    width: 0;
    height: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hud-root .help-scroll .unity-base-slider__dragger {
    width: 44px;
    min-height: 108px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/scroll_handle/scroll_handle_normal.png");
    -unity-background-scale-mode: scale-and-crop;
}

.hud-root .help-scroll .unity-base-slider__dragger:hover {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/scroll_handle/scroll_handle_hover.png");
}

.hud-root .help-scroll .unity-base-slider__dragger:active {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/scroll_handle/scroll_handle_pressed.png");
}

.hud-root .help-scroll .unity-base-slider__dragger:disabled {
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Components/05_settings_controls/scroll_handle/scroll_handle_disabled.png");
}

/*
 * ScrollView 的纵向滚动条内部仍会继承 Unity 默认主题的横向边距。
 * 外框、轨道和滑块必须共享同一条左边界，避免两个自定义滚动条看起来左右错位。
 */
.hud-root .help-scroll .unity-scroll-view__vertical-scroller,
.hud-root .log-panel .log-list .unity-scroll-view__vertical-scroller {
    padding: 0;
    align-items: center;
}

.hud-root .help-scroll .unity-scroller__slider,
.hud-root .log-panel .log-list .unity-scroller__slider {
    align-self: center;
}

.hud-root .help-scroll .unity-base-slider__input,
.hud-root .log-panel .log-list .unity-base-slider__input,
.hud-root .help-scroll .unity-base-slider__drag-container,
.hud-root .log-panel .log-list .unity-base-slider__drag-container {
    left: 0;
    right: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

.hud-root .help-scroll .unity-base-slider__tracker,
.hud-root .log-panel .log-list .unity-base-slider__tracker {
    left: 0;
    right: 0;
    margin-left: 0;
    margin-right: 0;
}

.hud-root .help-scroll .unity-base-slider__dragger,
.hud-root .log-panel .log-list .unity-base-slider__dragger {
    left: 0;
    margin-left: 0;
    margin-right: 0;
    translate: 0 0;
}

.hud-root .help-heading {
    margin-top: 10px;
    margin-bottom: 6px;
    font-size: 22px;
    color: rgb(108, 201, 255);
    -unity-font-style: bold;
}

.hud-root .help-copy {
    margin-bottom: 8px;
    font-size: 17px;
    color: rgb(230, 236, 244);
    white-space: normal;
}

.hud-root .utility-close-button {
    position: absolute;
    left: 50%;
    top: 462px;
    translate: -50% 0;
    width: 300px;
    min-width: 300px;
    height: 60px;
    margin: 0;
    margin-right: 0;
    -unity-background-scale-mode: scale-and-crop;
}

/* 选中详情复用实体卡面的文字层级：竖向构图，单张高斯透明度纹理以九宫格保持连续柔边。 */
.detail-card-info {
    position: absolute;
    bottom: 230px;
    width: 430px;
    height: 340px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    overflow: visible;
}

.detail-card-info-left {
    left: 28px;
}

.detail-card-info-right {
    right: 28px;
}

.detail-backdrop-blur {
    position: absolute;
    left: -80px;
    right: -80px;
    top: -80px;
    bottom: -80px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Imported/SpotlightArt/UI/Loose/detail_backdrop_blur.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 112;
    -unity-slice-right: 112;
    -unity-slice-top: 112;
    -unity-slice-bottom: 112;
}

.detail-edge-accent {
    position: absolute;
    left: 0;
    top: 10px;
    width: 4px;
    height: 150px;
    border-radius: 2px;
    background-color: rgb(236, 62, 43);
}

.detail-card-info-right .detail-edge-accent {
    background-color: rgb(55, 139, 255);
}

.detail-title,
.detail-meta,
.detail-stat-value,
.detail-trait-tag,
.detail-body {
    color: rgb(250, 247, 235);
    -unity-font-style: bold;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(0, 5, 12);
    text-shadow: 3px 3px 3px rgba(0, 0, 0, 1);
}

.detail-title {
    position: absolute;
    left: 18px;
    right: 4px;
    top: 4px;
    height: 52px;
    margin: 0;
    font-size: 40px;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.detail-meta {
    position: absolute;
    left: 18px;
    top: 55px;
    width: 360px;
    height: 32px;
    margin: 0;
    font-size: 24px;
    color: rgb(239, 238, 230);
    white-space: nowrap;
}

.detail-rule {
    position: absolute;
    left: 18px;
    top: 91px;
    width: 286px;
    height: 6px;
    flex-direction: row;
}

.detail-rule-light {
    width: 46%;
    height: 6px;
    background-color: rgb(246, 242, 224);
    border-radius: 3px;
}

.detail-rule-accent {
    flex-grow: 1;
    height: 6px;
    background-color: rgb(236, 62, 43);
    border-radius: 3px;
}

.detail-card-info-right .detail-rule-accent {
    background-color: rgb(55, 139, 255);
}

.detail-stats {
    position: absolute;
    left: 12px;
    top: 106px;
    width: 300px;
    height: 128px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.detail-stat {
    width: 88px;
    height: 126px;
    align-items: center;
    justify-content: flex-start;
}

.detail-stat-icon {
    width: 64px;
    height: 64px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.detail-icon-attack {
    background-image: url("project://database/Assets/Imported/SpotlightArt/Cards/atp.png");
}

.detail-icon-health {
    background-image: url("project://database/Assets/Imported/SpotlightArt/Cards/hp.png");
}

.detail-icon-move {
    background-image: url("project://database/Assets/Imported/SpotlightArt/Cards/mtp.png");
}

.detail-stat-value {
    height: 62px;
    margin: -2px 0 0 0;
    font-size: 50px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.detail-trait-row {
    position: absolute;
    left: 16px;
    right: 8px;
    top: 238px;
    min-height: 94px;
    flex-direction: row;
    align-items: flex-start;
}

.detail-trait-tag {
    width: 68px;
    margin: 0 8px 0 0;
    font-size: 25px;
    color: rgb(255, 67, 49);
    white-space: nowrap;
}

.detail-body {
    flex-grow: 1;
    margin: 1px 0 0 0;
    font-size: 19px;
    color: rgb(250, 247, 235);
    white-space: normal;
}

.hud-root .detail-card-info-left .withdraw-button {
    position: absolute;
    left: 322px;
    top: 166px;
    width: 108px;
    min-width: 108px;
    height: 42px;
    margin: 0;
}

/* ── 牌堆 / 墓地计数：同一张卡背底图 + 正中数字 + 上方标题 + 下方阶级小字 ──
   底图是 Assets/Imported/SpotlightArt/CardArt/backside.png（124×183，2:3 的卡背），
   因此面板做成卡形（165×244，等比约 1.33 倍），并允许上缘越出底部操作区。
   换图只改这一条 background-image；若新图不是 2:3，同步改 width/height。
   ⚠️ 换图后如果界面没变化，右键本文件 → Reimport：
   USS 会把图片路径解析成 GUID 缓存进导入产物，图片 GUID 变了必须重导本文件。 */
.pile-panel {
    position: absolute;
    bottom: 42px;
    width: 165px;
    height: 244px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/Imported/SpotlightArt/CardArt/backside.png");
    -unity-background-scale-mode: scale-to-fill;
}

.pile-left {
    left: 80px;
}

.pile-right {
    right: 80px;
}

/* 标题贴数字上方：绝对定位，避免牌堆多一行阶级小字把数字顶偏。
   卡背是彩色插画，标题与阶级小字各带一条半透明底带（Label 自身背景），
   这样文字不依赖插画底色也能读清，同时卡面花纹仍然可见。 */
.pile-title {
    position: absolute;
    top: 27px;
    left: 12px;
    right: 12px;
    padding: 2px 0;
    font-size: 18px;
    color: rgb(255, 255, 255);
    background-color: rgba(4, 12, 26, 0.75);
    border-radius: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(2, 6, 14, 0.95);
}

/* 数字始终居中于卡面正中：两块面板因此对齐。
   卡背是彩色插画，所以字号放大到 54px 并加 4px 深色描边，保证任何底色上都可读。 */
.pile-value {
    font-size: 64px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgba(2, 6, 14, 0.95);
}

/* 阶级小字贴底部，不参与垂直居中，所以不会影响数字位置。 */
.pile-tiers {
    position: absolute;
    bottom: 22px;
    left: 12px;
    right: 12px;
    padding: 3px 0;
    font-size: 14px;
    color: rgb(255, 255, 255);
    background-color: rgba(4, 12, 26, 0.75);
    border-radius: 4px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(2, 6, 14, 0.95);
}

/* 齿轮菜单的遮罩：沿用 .overlay / .overlay-card，只加深底色以突出中间两个按钮。 */
.menu-overlay {
    background-color: rgba(0, 0, 0, 0.5);
}

/* 菜单里的“配置/调试”：与「继续 / 重开」拉开距离，避免误点（正式包里该按钮不显示）。 */
.action-button.menu-debug-button {
    margin-top: 18px;
}

/* 菜单里的“退出游戏”：用警示色与「继续 / 重开」区分，降低误点退出（退出后无法回到本局）。 */
.action-button.menu-quit-button {
    background-color: rgb(96, 40, 48);
    border-left-color: rgb(200, 96, 110);
    border-right-color: rgb(200, 96, 110);
    border-top-color: rgb(200, 96, 110);
    border-bottom-color: rgb(200, 96, 110);
}

/* 上面的规则胜过后写的 .action-button:hover，因此退出按钮需要单独定义悬停色。 */
.action-button.menu-quit-button:hover {
    background-color: rgb(126, 52, 62);
}

/* ── 携带选择面板 ──────────────────────────────────────────────────────── */

.deck-select-mask {
    align-items: center;
}

.deck-select-panel {
    width: 1000px;
    flex-grow: 1;
    flex-shrink: 1;
}

.deck-select-foot {
    flex-direction: row;
    align-items: center;
    padding: 12px 20px;
    border-top-width: 1px;
    border-top-color: #2a3448;
}

/* 选卡面板底部的抽牌堆预览：独立类名，避免与调试面板的 cfg-deck-summary 撞类后被按类查询取到空标签。 */
.deck-select-preview {
    flex-grow: 1;
    margin-right: 16px;
    font-size: 15px;
    color: rgb(200, 220, 255);
    white-space: normal;
}

/* 每个阶级一组：左侧彩色竖条 + 阶级徽章 + 计数，组内只放该阶级的卡种行。
   初级=绿、中级=蓝、高级=紫，三处（分组竖条 / 徽章 / 行内短标）使用同一套颜色，
   让玩家即使只看卡片行也能判断阶级。 */
.deck-tier {
    margin-bottom: 14px;
    padding-left: 10px;
    border-left-width: 4px;
    border-left-color: #2a3448;
}

.deck-tier.tier-basic { border-left-color: #3ddc97; }
.deck-tier.tier-intermediate { border-left-color: #4aa3ff; }
.deck-tier.tier-advanced { border-left-color: #c084fc; }

.deck-tier-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.deck-tier-badge {
    font-size: 14px;
    -unity-font-style: bold;
    color: #0b1220;
    padding: 2px 12px;
    margin-right: 10px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.tier-basic .deck-tier-badge { background-color: #3ddc97; }
.tier-intermediate .deck-tier-badge { background-color: #4aa3ff; }
.tier-advanced .deck-tier-badge { background-color: #c084fc; }

.deck-tier-count {
    font-size: 15px;
    color: rgb(240, 245, 255);
    -unity-font-style: bold;
    margin-right: 12px;
}

.deck-tier-pile {
    font-size: 13px;
    color: rgb(160, 200, 255);
}

/* 行内阶级短标（初 / 中 / 高）：颜色与所属分组一致。 */
.deck-card-tier-tag {
    width: 26px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #0b1220;
    -unity-text-align: middle-center;
    margin-right: 8px;
    padding: 1px 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.tier-basic .deck-card-tier-tag { background-color: #3ddc97; }
.tier-intermediate .deck-card-tier-tag { background-color: #4aa3ff; }
.tier-advanced .deck-card-tier-tag { background-color: #c084fc; }

.deck-card-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    margin-bottom: 3px;
    background-color: #1b2436;
    border-left-width: 3px;
    border-left-color: #2a3448;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.deck-card-row.selected {
    border-left-color: #33ff99;
    background-color: #20304a;
}

.deck-card-row Button {
    width: 76px;
    margin-right: 10px;
}

.deck-card-name {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(240, 245, 255);
}

.deck-card-copies {
    width: 110px;
    font-size: 15px;
    color: rgb(160, 200, 255);
    -unity-text-align: middle-right;
}
