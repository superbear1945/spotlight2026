<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="04-turnflow" name="Spotlight 回合流程与 Boss 三阶段状态机">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="turns" value="&lt;b&gt;公共回合流程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;GameSession 持有唯一状态；UI 仅播放结果&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dbe5f1;strokeWidth=1.4;dashed=1;dashPattern=1 3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="920" height="1870" as="geometry"/></mxCell>
        <mxCell id="phases" value="&lt;b&gt;阶段转换与技能调度&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;BossPhaseStateMachine · 单向转换，不按卡名分支&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dbe5f1;strokeWidth=1.4;dashed=1;dashPattern=1 3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="960" height="1870" as="geometry"/></mxCell>
        <mxCell id="start" value="&lt;b&gt;行动方回合开始&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;所属阵营回合序号 +1
Boss 一阶段读取一次压力条件&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="240" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="restore" value="&lt;b&gt;恢复已有行动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;双方家及所属阵营现存单位恢复
后续生成的新单位不会再次恢复&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="460" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="public" value="&lt;b&gt;玩家回合公共结算&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;已有炸弹到期引爆 → 资源 / 维持费 → 抽牌
Boss 回合跳过这些玩家结算&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="680" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="spawn" value="&lt;b&gt;通用刷怪&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;已满足首次生成资格的来源按部署顺序处理
空格优先；允许的顶替；无位置暂停&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="900" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="phase" value="&lt;b&gt;当前 Boss 阶段技能&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;调用 OnPlayerTurnStarted / OnBossTurnStarted
具体技能由右侧一、二、三阶段决定&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="1120" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="actions" value="&lt;b&gt;普通行动与每次攻击结算&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;放牌 / 移动 / 攻击 / 治疗 / 互换；保留能力结算
Boss AI：目标过滤与寻路，按部署顺序行动&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="1340" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="end" value="&lt;b&gt;结束当前行动回合&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;每次攻击先处理阶段转换，再判断胜负
玩家手牌超限必须先弃牌&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="1560" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="next" value="&lt;b&gt;交给另一方&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;AI Boss 自动结束；手动可跳过普通放牌
双方完成行动后完整回合号 +1&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="1780" width="680" height="145" as="geometry"/></mxCell>
        <mxCell id="one" value="&lt;b&gt;一阶段 · Boss 默认 30 血&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;玩家回合：新炸弹机会
Boss 回合：普通刷怪笼机会、AI 固定兵位补兵&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="250" width="720" height="140" as="geometry"/></mxCell>
        <mxCell id="threshold" value="&lt;b&gt;伤害触及阈值 · 默认 20&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;本次扣血截断到阈值，先转阶段再判胜负
超额致死伤害不能跳过二阶段&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="490" width="720" height="150" as="geometry"/></mxCell>
        <mxCell id="two" value="&lt;b&gt;二阶段 · Boss 锁血且不可攻击&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;立即自动部署总共两艘战舰，手动模式相同
三等分行 / 玩家视角第 8 列 / 占位找最近空格
满盘保留待部署，下次 Boss 回合重试&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="760" width="720" height="190" as="geometry"/></mxCell>
        <mxCell id="ships" value="&lt;b&gt;仅跟踪两艘指定战舰&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;待部署不算击败；存活时保持二阶段
普通刷怪笼和战机死亡不计数；战舰不补回&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="1090" width="720" height="160" as="geometry"/></mxCell>
        <mxCell id="three" value="&lt;b&gt;三阶段 · 两舰阵亡立即解锁&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;保留普通行动、现存刷怪与手动普通放牌
新技能入口占位，不恢复一阶段、不重入二阶段&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="1400" width="720" height="160" as="geometry"/></mxCell>
        <mxCell id="finish" value="&lt;b&gt;后续伤害照常结算与判断胜负&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;二、三阶段均不新增一阶段技能
已有炸弹始终按期爆炸，现存单位持续行动&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;shadow=0;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="1740" width="720" height="140" as="geometry"/></mxCell>
        <mxCell id="turn-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="restore"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="turn-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="restore" target="public"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="turn-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="public" target="spawn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="turn-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="spawn" target="phase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="turn-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="phase" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="turn-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="actions" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="turn-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="end" target="next"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="next-turn" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#ef4444;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="next" target="start"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="one-hit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#ef4444;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="one" target="threshold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="enter-two" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#ef4444;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="threshold" target="two"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="watch-ships" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="two" target="ships"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pending" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#6b7280;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ships" target="two"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="both-dead" value="两艘均已击败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#ef4444;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ships" target="three"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="after-three" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#2563eb;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="three" target="finish"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="page-title" value="Spotlight 回合流程与 Boss 三阶段状态机" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#111827;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="2000" height="40" as="geometry"/></mxCell>
        <mxCell id="page-subtitle" value="MatchPhase 管理行动 / 弃牌 / 结束；BossPhase 独立管理技能阶段与锁血" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="58" width="2000" height="28" as="geometry"/></mxCell>
