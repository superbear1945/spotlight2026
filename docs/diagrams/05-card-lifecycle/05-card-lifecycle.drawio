<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="05-card-lifecycle" name="Spotlight 卡牌生命周期与墓地循环">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1370" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c-loop" value="&lt;b&gt;循环区：卡牌记录唯一流转，总数恒定&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;卡组 → 抽牌堆 → 手牌 → 墓地 →（抽牌堆耗尽）→ 洗回抽牌堆&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dbe5f1;strokeWidth=1.4;dashed=1;dashPattern=1 3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="1080" height="410" as="geometry"/></mxCell>
        <mxCell id="c-board" value="&lt;b&gt;场地：战斗单位独立存在&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;UnitState 只保存来源卡的值副本（SourceCardId / TypeId / Owner），不引用 CardRecord&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dbe5f1;strokeWidth=1.4;dashed=1;dashPattern=1 3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1080" height="310" as="geometry"/></mxCell>
        <mxCell id="c-boss" value="&lt;b&gt;Boss 独立回收区&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;Boss 单位阵亡进入独立回收区，不参与玩家洗回；本次只调整玩家机制&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#dbe5f1;strokeWidth=1.4;dashed=1;dashPattern=1 3;verticalAlign=top;align=left;spacingLeft=14;spacingTop=10;fontColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="980" width="1080" height="210" as="geometry"/></mxCell>
        <mxCell id="n-deck" value="&lt;b&gt;卡组 Deck&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;卡种与数量清单&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="n-draw" value="&lt;b&gt;抽牌堆 DrawPile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;玩家每回合抽牌来源&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="n-hand" value="&lt;b&gt;手牌 Hand&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;已抽到、未打出，不参与洗回&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="260" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="n-grave" value="&lt;b&gt;墓地 Graveyard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;成功部署或弃置的玩家卡&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="n-unit-a" value="&lt;b&gt;战斗单位 A&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;Id · SourceCardId · TypeId · Owner&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="700" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="n-unit-b" value="&lt;b&gt;战斗单位 B（同一张卡）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;位置、伤势、行动与 A 互不影响&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#f0fdfa;strokeColor=#0d9488;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="n-remove" value="&lt;b&gt;离场：阵亡 / 被覆盖&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;来源卡不重复回收&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="700" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="n-boss-grave" value="&lt;b&gt;Boss 回收区&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b&quot;&gt;不进入玩家的抽牌堆或墓地&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;shadow=0;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.8;fontColor=#111827;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="140" y="1030" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="e-deck-draw" value="生成卡牌记录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-deck" target="n-draw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-draw-hand" value="抽牌" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#f97316;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-draw" target="n-hand"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-grave-draw" value="洗回抽牌堆" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#2563eb;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-grave" target="n-draw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-hand-grave" value="部署 / 弃置入墓地" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#10b981;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-hand" target="n-grave"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-hand-unit-a" value="部署出满血新单位" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#7c3aed;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-hand" target="n-unit-a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-unit-a-b" value="同一张卡" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;shadow=0;endArrow=block;endFill=1;jumpStyle=arc;strokeColor=#6b7280;strokeWidth=2.4;fontColor=#64748b;fontSize=12;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-unit-a" target="n-unit-b"><mxGeometry relative="1" as="geometry"/></mxCell>
