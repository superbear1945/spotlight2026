<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <Style src="project://database/Assets/Spotlight/UI/Spotlight.uss?fileID=7433441132597879392&amp;guid=622fd0c24e0a84a428530e1d6ba8c5c9&amp;type=3#Spotlight" />
  <!-- 调试配置面板骨架：只在编辑器里加载（Assets/Spotlight/Runtime/Debug/ConfigDebugPanel.cs 通过 AssetDatabase 读取）。
       不要合并回 Spotlight.uxml，也不要放进 Resources/，否则正式包会重新带上调试界面。 -->
  <ui:VisualElement name="debug-panel" class="cfg-mask">
    <ui:VisualElement class="cfg-panel">
      <ui:VisualElement class="cfg-head">
        <ui:VisualElement class="cfg-head-top">
          <ui:Label text="⚙ 对局配置" class="cfg-title" />
          <ui:VisualElement class="cfg-head-actions">
            <ui:Button name="debug-reset-button" text="恢复默认" />
            <ui:Button name="debug-close-button" text="关闭" />
            <ui:Button name="debug-apply-button" text="应用并重开" class="primary" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="debug-error" class="cfg-error" />
      </ui:VisualElement>
      <ui:VisualElement class="cfg-body">
        <ui:ScrollView name="debug-scroll" mode="Vertical" class="cfg-scroll">
          <ui:Label text="修改仅在“应用并重开”后生效。关闭后保留草稿，重新打开可继续编辑。" class="cfg-note" />
          <ui:VisualElement name="debug-board" />
          <ui:VisualElement name="debug-home" />
          <ui:VisualElement name="debug-deck" />
          <ui:VisualElement name="debug-cards" />
          <ui:VisualElement name="debug-boss" />
          <ui:VisualElement name="debug-turn" />
          <ui:VisualElement name="debug-toggles" />
          <ui:VisualElement class="cfg-section">
            <ui:Label text="JSON 导入 / 导出" class="cfg-section-title" />
            <ui:Label text="复制完整配置 JSON 后可粘贴到文本文件保存。导入前请先复制文件中的全部 JSON；导入只修改草稿，应用并重开后生效。" class="cfg-note" />
            <ui:VisualElement class="cfg-json-actions">
              <ui:Button name="debug-export-button" text="复制 JSON" />
              <ui:Button name="debug-import-button" text="从剪贴板导入" />
            </ui:VisualElement>
            <ui:Label name="debug-json-status" class="cfg-note" />
          </ui:VisualElement>
        </ui:ScrollView>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
