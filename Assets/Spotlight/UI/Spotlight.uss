/* 静态界面样式。颜色与尺寸集中在此文件，便于策划在不改代码的情况下调整面板外观；
   卡牌与棋盘的语义颜色来自 Excel 的 Presentation 表，不在此重复定义。 */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 顶部信息条 */
.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 8px 16px;
    background-color: rgba(12, 16, 24, 0.78);
}

.title-label {
    font-size: 20px;
    color: rgb(240, 245, 255);
    -unity-font-style: bold;
}

.info-label {
    font-size: 15px;
    color: rgb(210, 224, 245);
    margin-left: 24px;
    white-space: normal;
}

.warn-label {
    font-size: 15px;
    color: rgb(255, 210, 120);
    white-space: normal;
}

.section-label {
    font-size: 15px;
    color: rgb(160, 200, 255);
    margin-top: 6px;
    margin-bottom: 2px;
    -unity-font-style: bold;
}

.detail-label {
    font-size: 14px;
    color: rgb(225, 232, 245);
    white-space: normal;
}

.log-line {
    font-size: 13px;
    color: rgb(200, 214, 235);
    white-space: normal;
    margin-bottom: 2px;
}

/* 通用面板 */
.panel {
    background-color: rgba(10, 14, 22, 0.82);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(80, 120, 190, 0.55);
    border-right-color: rgba(80, 120, 190, 0.55);
    border-top-color: rgba(80, 120, 190, 0.55);
    border-bottom-color: rgba(80, 120, 190, 0.55);
    padding: 8px 10px;
}

.log-panel {
    position: absolute;
    left: 12px;
    bottom: 64px;
    width: 420px;
    height: 240px;
}

.log-list {
    flex-grow: 1;
}

.log-content {
    flex-direction: column;
}

.side-panel {
    position: absolute;
    right: 12px;
    top: 64px;
    width: 380px;
    max-height: 420px;
}

/* 底部按钮条：左移 252px，给同一行的左侧“墓地”计数让位（棋盘与手牌的位置不变）。
   按钮仍然从左往右排列，因此不会与右侧的“抽牌堆 / 结束回合”区域重叠。 */
.bottom-bar {
    position: absolute;
    left: 264px;
    right: 12px;
    bottom: 12px;
    flex-direction: row;
}

.action-button {
    font-size: 15px;
    margin-right: 8px;
    padding: 6px 14px;
    background-color: rgb(38, 52, 78);
    color: rgb(235, 242, 255);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(90, 130, 200);
    border-right-color: rgb(90, 130, 200);
    border-top-color: rgb(90, 130, 200);
    border-bottom-color: rgb(90, 130, 200);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* 选中详情里的“离场”按钮：只占内容宽度，避免在侧栏里被拉伸成整行 */
.withdraw-button {
    align-self: flex-start;
    margin-top: 8px;
    margin-right: 0;
}

.action-button:hover {
    background-color: rgb(54, 74, 108);
}

.action-button.primary {
    background-color: rgb(52, 110, 82);
    border-left-color: rgb(90, 200, 140);
    border-right-color: rgb(90, 200, 140);
    border-top-color: rgb(90, 200, 140);
    border-bottom-color: rgb(90, 200, 140);
}

.error-label {
    position: absolute;
    left: 50%;
    top: 64px;
    translate: -50% 0;
    padding: 6px 14px;
    font-size: 15px;
    color: rgb(255, 235, 235);
    background-color: rgba(150, 40, 40, 0.88);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    white-space: normal;
    max-width: 900px;
}

/* 遮罩 */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.modal-overlay {
    background-color: rgba(0, 0, 0, 0.35);
}

.overlay-card {
    background-color: rgba(14, 20, 32, 0.94);
    padding: 24px 32px;
    align-items: center;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.victory-label {
    font-size: 32px;
    color: rgb(255, 245, 210);
    -unity-font-style: bold;
    margin-bottom: 16px;
}

/* ── 对局配置面板（表单式） ──────────────────────────────────────────────
   视觉与既有网页版配置界面一致：深色面板、分区标题、自适应字段网格、卡片式卡种编辑框。
   面板默认隐藏，只能由“配置/调试”按钮打开；遮罩本身会拦截点击，规则层另有输入闸门。 */

.cfg-mask {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 8, 16, 0.72);
    align-items: flex-start;
    justify-content: center;
    padding: 24px;
}

.cfg-panel {
    width: 880px;
    max-width: 100%;
    max-height: 100%;
    background-color: #151c2b;
    border-width: 1px;
    border-color: #2a3448;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.cfg-head {
    flex-direction: column;
    padding: 14px 16px;
    border-bottom-width: 1px;
    border-bottom-color: #2a3448;
    background-color: #151c2b;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}

.cfg-head-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.cfg-title {
    font-size: 16px;
    color: #e6ecff;
    -unity-font-style: bold;
}

.cfg-head-actions {
    flex-direction: row;
}

.cfg-head-actions Button {
    margin-left: 8px;
}

.cfg-error {
    color: #ef4444;
    font-size: 12px;
    white-space: normal;
    margin-top: 8px;
    display: none;
}

.cfg-body {
    flex-grow: 1;
    padding: 8px 16px 20px;
}

.cfg-scroll {
    flex-grow: 1;
}

/* 分区 */
.cfg-section {
    padding: 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: #2a3448;
}

.cfg-section-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.cfg-section-title {
    font-size: 13.5px;
    color: #9fb6de;
    -unity-font-style: bold;
}

.cfg-note {
    font-size: 12px;
    color: #6f86ad;
    white-space: normal;
    margin-top: 8px;
}

.cfg-deck-summary {
    font-size: 13px;
    color: #c6d2e8;
    margin-top: 4px;
}

/* 字段网格：等价于 repeat(auto-fill, minmax(200px, 1fr)) */
.cfg-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.cfg-field {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 190px;
    min-width: 170px;
    margin-right: 10px;
    margin-bottom: 10px;
}

.cfg-field-label {
    font-size: 12.5px;
    color: #8b97b0;
    margin-bottom: 4px;
}

/* 输入控件 */
.cfg-input {
    font-size: 13px;
    color: #e6ecff;
}

.cfg-input .unity-base-field__input,
.cfg-input .unity-text-field__input,
.cfg-input .unity-integer-field__input,
.cfg-input .unity-base-text-field__input {
    background-color: #0f1624;
    border-width: 1px;
    border-color: #2a3448;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 6px 8px;
    color: #e6ecff;
}

/* 复选框行 */
.cfg-toggle {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.cfg-toggle-label {
    font-size: 13px;
    color: #c6d2e8;
    margin-left: 8px;
    white-space: normal;
}

.cfg-toggles {
    flex-direction: row;
    flex-wrap: wrap;
}

.cfg-toggles .cfg-toggle {
    flex-grow: 1;
    flex-basis: 280px;
    min-width: 260px;
}

/* 卡种编辑卡片 */
.cfg-card {
    margin-top: 12px;
    padding: 12px;
    border-width: 1px;
    border-color: #2a3448;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.cfg-card-title {
    font-size: 14px;
    color: #e6ecff;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

/* 按钮 */
.cfg-panel Button {
    border-width: 1px;
    border-color: #2a3448;
    background-color: #1c2436;
    color: #e6ecff;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding: 8px 14px;
    font-size: 13px;
    -unity-text-align: middle-center;
}

.cfg-panel Button:hover {
    border-color: #3d4d6b;
    background-color: #232e44;
}

.cfg-panel Button.primary {
    background-color: #2f63d6;
    border-color: #4f8cff;
    -unity-font-style: bold;
}

.cfg-panel Button.primary:hover {
    background-color: #3a70e6;
}

/* JSON 导入导出 */
.cfg-json-actions {
    flex-direction: row;
    margin-top: 8px;
    margin-bottom: 8px;
}

.cfg-json-actions Button {
    margin-right: 8px;
}

.cfg-json {
    min-height: 180px;
    font-size: 12px;
}

.bomb-button { border-bottom-color: rgb(220, 110, 45); border-bottom-width: 2px; }

/* ── 战斗界面（新 UI，默认显示） ──────────────────────────────────────────
   布局预算（与 SpotlightMenu 生成的容器尺寸保持一致，改动请同时改两处）：
   - 棋盘维持现状：x∈[460,1520]、y∈[250,1010]（Canvas 参考分辨率 1920×1080）；
     因此左侧余 460px、右侧余 400px，正好容纳左右详情区（左 420 / 右 380）；
   - 手牌行：左“墓地”240 + 居中手牌 1020 + 右“抽牌堆 / 结束回合”380；
   - 详情区与卡牌计数都只是占位与展示，真正的合法性仍由规则层给出。 */
.action-button.menu-button {
    position: absolute;
    left: 12px;
    top: 46px;
    width: 42px;
    height: 42px;
    font-size: 20px;
    margin-right: 0;
    -unity-text-align: middle-center;
}

.detail-panel {
    position: absolute;
    top: 300px;
    height: 400px;
}

.detail-panel-left {
    left: 12px;
    width: 420px;
}

.detail-panel-right {
    right: 12px;
    width: 380px;
}

.detail-title {
    font-size: 16px;
    color: rgb(160, 200, 255);
    -unity-font-style: bold;
    white-space: normal;
}

.detail-body {
    font-size: 14px;
    color: rgb(225, 232, 245);
    white-space: normal;
    margin-top: 6px;
}

/* 手牌同一行的卡牌计数区 */
.pile-panel {
    position: absolute;
    bottom: 16px;
    height: 190px;
    align-items: center;
    justify-content: center;
}

.pile-left {
    left: 12px;
    width: 240px;
}

.pile-right {
    right: 12px;
    width: 380px;
}

.pile-title {
    font-size: 15px;
    color: rgb(160, 200, 255);
    -unity-font-style: bold;
}

.pile-count {
    font-size: 36px;
    color: rgb(240, 245, 255);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

/* 齿轮菜单的遮罩：沿用 .overlay / .overlay-card，只加深底色以突出中间两个按钮。 */
.menu-overlay {
    background-color: rgba(0, 0, 0, 0.5);
}

/* 菜单里的“配置/调试”：与「继续 / 重开」拉开距离，避免误点（正式包里该按钮不显示）。 */
.action-button.menu-debug-button {
    margin-top: 18px;
}
