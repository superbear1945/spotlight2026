# Unity .gitattributes
# Normalize line endings; treat Unity YAML/text assets as text so diffs and merges work.

* text=auto

# Unity YAML assets are text and mergeable with UnityYAMLMerge
*.meta   text diff=unity
*.unity  text diff=unity
*.prefab text diff=unity
*.asset  text diff=unity
*.mat    text diff=unity
*.anim   text diff=unity
*.controller text diff=unity
*.overrideController text diff=unity
*.physicMaterial2D text diff=unity
*.physicsMaterial2D text diff=unity
*.preset text diff=unity
*.scenetemplate text diff=unity
*.guiskin text diff=unity
*.mixer  text diff=unity
*.shadervariants text diff=unity

# C# / shader / config files
*.cs      text diff=csharp
*.shader  text
*.cginc   text
*.hlsl    text
*.compute text
*.json    text
*.xml     text
*.yml     text
*.yaml    text
*.asmdef  text
*.rsp     text
*.txt     text

# Binary assets – must not be interpreted as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.tga  binary
*.psd  binary
*.tif  binary
*.tiff binary
*.exr  binary
*.hdr  binary
*.bmp  binary

*.fbx  binary
*.obj  binary
*.blend binary
*.dae  binary
*.3ds  binary
*.max  binary
*.ma   binary
*.mb   binary

*.wav  binary
*.mp3  binary
*.ogg  binary
*.aiff binary
*.aif  binary
*.flac binary

*.mp4  binary
*.mov  binary
*.webm binary
*.avi  binary

*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

*.dll  binary
*.so   binary
*.dylib binary
*.a    binary
*.bundle binary
*.apk  binary
*.aab  binary
*.unitypackage binary
*.cubemap binary
*.physicMaterial binary
*.physicsMaterial binary

