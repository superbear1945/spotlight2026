      <ui:Label name="phase-label" picking-mode="Ignore" class="warn-label" />
      <ui:Label text="选中详情" picking-mode="Ignore" class="section-label" />
      <ui:Label name="unit-detail" text="点击手牌、己方单位或己方家进行操作" picking-mode="Ignore" class="detail-label" />
    </ui:VisualElement>
    <ui:VisualElement name="detail-left" picking-mode="Ignore" class="detail-card-info detail-card-info-left" style="display: none;">
      <ui:VisualElement picking-mode="Ignore" class="detail-backdrop-blur" />
      <ui:VisualElement picking-mode="Ignore" class="detail-edge-accent" />
      <ui:Label name="detail-left-title" picking-mode="Ignore" class="detail-title" />
      <ui:Label name="detail-left-meta" picking-mode="Ignore" class="detail-meta" />
      <ui:VisualElement picking-mode="Ignore" class="detail-rule">
        <ui:VisualElement picking-mode="Ignore" class="detail-rule-light" />
        <ui:VisualElement picking-mode="Ignore" class="detail-rule-accent" />
      </ui:VisualElement>
      <ui:VisualElement picking-mode="Ignore" class="detail-stats">
        <ui:VisualElement picking-mode="Ignore" class="detail-stat">
          <ui:VisualElement tooltip="攻击" picking-mode="Ignore" class="detail-stat-icon detail-icon-attack" />
          <ui:Label name="detail-left-attack" text="0" picking-mode="Ignore" class="detail-stat-value" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="detail-stat">
          <ui:VisualElement tooltip="生命" picking-mode="Ignore" class="detail-stat-icon detail-icon-health" />
          <ui:Label name="detail-left-health" text="0" picking-mode="Ignore" class="detail-stat-value" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="detail-stat">
          <ui:VisualElement tooltip="移动" picking-mode="Ignore" class="detail-stat-icon detail-icon-move" />
          <ui:Label name="detail-left-move" text="0" picking-mode="Ignore" class="detail-stat-value" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement picking-mode="Ignore" class="detail-trait-row">
        <ui:Label name="detail-left-trait" text="特性" picking-mode="Ignore" class="detail-trait-tag" />
        <ui:Label name="detail-left-body" picking-mode="Ignore" class="detail-body" />
      </ui:VisualElement>
      <ui:Button name="withdraw-button" text="离场" class="action-button secondary-action withdraw-button" style="display: none;" />
    </ui:VisualElement>
    <ui:VisualElement name="detail-right" picking-mode="Ignore" class="detail-card-info detail-card-info-right" style="display: none;">
      <ui:VisualElement picking-mode="Ignore" class="detail-backdrop-blur" />
      <ui:VisualElement picking-mode="Ignore" class="detail-edge-accent" />
      <ui:Label name="detail-right-title" picking-mode="Ignore" class="detail-title" />
      <ui:Label name="detail-right-meta" picking-mode="Ignore" class="detail-meta" />
      <ui:VisualElement picking-mode="Ignore" class="detail-rule">
        <ui:VisualElement picking-mode="Ignore" class="detail-rule-light" />
        <ui:VisualElement picking-mode="Ignore" class="detail-rule-accent" />
      </ui:VisualElement>
      <ui:VisualElement picking-mode="Ignore" class="detail-stats">
        <ui:VisualElement picking-mode="Ignore" class="detail-stat">
          <ui:VisualElement tooltip="攻击" picking-mode="Ignore" class="detail-stat-icon detail-icon-attack" />
          <ui:Label name="detail-right-attack" text="0" picking-mode="Ignore" class="detail-stat-value" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="detail-stat">
          <ui:VisualElement tooltip="生命" picking-mode="Ignore" class="detail-stat-icon detail-icon-health" />
          <ui:Label name="detail-right-health" text="0" picking-mode="Ignore" class="detail-stat-value" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="detail-stat">
          <ui:VisualElement tooltip="移动" picking-mode="Ignore" class="detail-stat-icon detail-icon-move" />
          <ui:Label name="detail-right-move" text="0" picking-mode="Ignore" class="detail-stat-value" />
        </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement picking-mode="Ignore" class="detail-trait-row">
        <ui:Label name="detail-right-trait" text="特性" picking-mode="Ignore" class="detail-trait-tag" />
        <ui:Label name="detail-right-body" picking-mode="Ignore" class="detail-body" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="bottom-bar" picking-mode="Ignore" class="bottom-bar">
      <ui:Button name="bomb-deploy-button" text="布置炸弹" class="action-button primary-action bomb-button" style="display: none;" />
      <ui:Button name="bomb-skip-button" text="跳过炸弹" class="action-button secondary-action bomb-button" style="display: none;" />
      <ui:Button name="spawner-deploy-button" text="部署刷怪卡" class="action-button primary-action" style="display: none;" />
      <ui:Button name="spawner-skip-button" text="跳过刷怪卡" class="action-button secondary-action" style="display: none;" />
      <ui:Button name="skip-deploy-button" text="跳过放牌并结束" class="action-button secondary-action" style="display: none;" />
      <ui:Button name="restart-button" text="重开" class="action-button secondary-action" style="display: none;" />
    </ui:VisualElement>

    <!-- 牌堆与墓地共用同一套计数面板：底图 + 正中数字 + 上方标题 + 下方阶级小字。
         标题与数字都绝对定位（见 USS 的 .pile-title / .pile-value），
         所以牌堆多一行阶级小字也不会把数字顶偏，两块面板的数字始终在同一高度。 -->
    <ui:VisualElement name="pile-left" picking-mode="Ignore" class="pile-panel pile-left">
      <ui:Label text="墓地" picking-mode="Ignore" class="pile-title" />
      <ui:Label name="grave-count" text="0" picking-mode="Ignore" class="pile-value" />
    </ui:VisualElement>
    <ui:VisualElement name="pile-right" picking-mode="Ignore" class="pile-panel pile-right">
      <ui:Label text="牌堆" picking-mode="Ignore" class="pile-title" />
      <ui:Label name="draw-count" text="0" picking-mode="Ignore" class="pile-value" />
      <ui:Label name="draw-count-tiers" text="高 0 · 中 0 · 初 0" picking-mode="Ignore" class="pile-tiers" />
    </ui:VisualElement>
    <ui:VisualElement name="menu-overlay" class="overlay menu-overlay" style="display: none;">
      <ui:VisualElement picking-mode="Ignore" class="overlay-card">
        <ui:Label text="菜单" class="victory-label" />
        <ui:Button name="menu-resume-button" text="继续" class="action-button" />
        <ui:Button name="menu-deck-select-button" text="选卡" class="action-button" />
        <ui:Button name="menu-restart-button" text="重开" class="action-button" />
        <ui:Button name="menu-quit-button" text="退出游戏" class="action-button menu-quit-button" />
        <ui:Button name="debug-button" text="配置/调试" class="action-button menu-debug-button" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:Label name="error-label" picking-mode="Ignore" class="error-label" style="display: none;" />
    <ui:VisualElement name="victory-overlay" picking-mode="Ignore" class="overlay victory-overlay" style="display: none;">
      <ui:VisualElement picking-mode="Ignore" class="overlay-card">
        <ui:VisualElement name="victory-art" picking-mode="Ignore" class="result-art victory-art" style="display: none;" />
        <ui:VisualElement name="defeat-art" picking-mode="Ignore" class="result-art defeat-art" style="display: none;" />
        <ui:Label name="victory-label" picking-mode="Ignore" class="victory-label" />
        <ui:Button name="victory-restart-button" text="再来一局" class="action-button primary-action victory-restart-button" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="deck-select-confirm-overlay" class="overlay menu-overlay" style="display: none;">
      <ui:VisualElement picking-mode="Ignore" class="overlay-card">
        <ui:Label text="进入选卡？" class="victory-label" />
        <ui:Label text="确认后当前对局将重开，进度不会保留。" class="info-label" />
        <ui:Button name="deck-select-confirm-yes" text="进入选卡" class="action-button" />
        <ui:Button name="deck-select-confirm-no" text="继续当前对局" class="action-button" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="deck-select-mask" class="cfg-mask deck-select-mask" style="display: none;">
      <ui:VisualElement class="cfg-panel deck-select-panel">
        <ui:VisualElement class="cfg-head">
          <ui:VisualElement class="cfg-head-top">
            <ui:Label name="deck-select-title" text="携带选择" class="cfg-title" />
            <ui:VisualElement class="cfg-head-actions">
              <ui:Button name="deck-select-default-button" text="恢复默认" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:Label name="deck-select-error" class="cfg-error" />
        </ui:VisualElement>
        <ui:VisualElement class="cfg-body">
          <ui:ScrollView name="deck-select-scroll" mode="Vertical" class="cfg-scroll">
            <ui:Label name="deck-select-hint" class="cfg-note" />
            <ui:VisualElement name="deck-select-cards" />
          </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement class="deck-select-foot">
          <ui:Label name="deck-select-preview" class="deck-select-preview" />
          <ui:Button name="deck-select-cancel-button" text="取消" class="action-button" />
          <ui:Button name="deck-select-apply-button" text="确认并开局" class="action-button primary" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="modal-overlay" class="overlay modal-overlay" style="display: none;" />
    <ui:VisualElement name="pause-overlay" class="overlay pause-overlay" style="display: none;">
      <ui:VisualElement name="pause-panel" picking-mode="Ignore" class="pause-panel">
        <ui:VisualElement name="pause-header-left-line" picking-mode="Ignore" class="pause-header-line pause-header-left-line" />
        <ui:VisualElement name="pause-title-icon" picking-mode="Ignore" class="pause-title-icon" />
        <ui:VisualElement name="pause-header-right-line" picking-mode="Ignore" class="pause-header-line pause-header-right-line" />
        <ui:Button name="pause-close-button" text="" tooltip="继续战斗" class="pause-close-button" />
        <ui:Button name="pause-continue-button" text="继续战斗" class="pause-menu-button pause-continue-button" />
        <ui:Button name="pause-restart-button" text="重新开始" class="pause-menu-button pause-restart-button" />
        <ui:Button name="pause-exit-button" text="退出战斗" class="pause-menu-button pause-exit-button" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="settings-overlay" class="overlay utility-overlay" style="display: none;">
      <ui:VisualElement name="settings-panel" class="utility-panel settings-panel">
        <ui:VisualElement class="settings-title-row">
          <ui:VisualElement picking-mode="Ignore" class="settings-title-line" />
          <ui:Label text="设置" class="utility-title settings-title" />
          <ui:VisualElement picking-mode="Ignore" class="settings-title-line" />
        </ui:VisualElement>
        <ui:Button name="settings-x-button" text="×" tooltip="保存并返回" class="settings-x-button" />
        <ui:VisualElement class="settings-section-row settings-sound-section">
          <ui:Label text="声音" class="settings-section-title" />
          <ui:VisualElement picking-mode="Ignore" class="settings-section-line" />
        </ui:VisualElement>
        <ui:VisualElement class="settings-control-row settings-master-row">
          <ui:Label text="主音量" class="settings-control-label" />
          <ui:VisualElement class="settings-slider-shell">
            <ui:VisualElement name="master-volume-fill" picking-mode="Ignore" class="settings-slider-fill-clip">
              <ui:VisualElement picking-mode="Ignore" class="settings-slider-fill-art" />
            </ui:VisualElement>
            <ui:Slider name="master-volume-slider" low-value="0" high-value="100" value="100" class="settings-slider" />
          </ui:VisualElement>
          <ui:Label name="master-volume-value" text="100%" picking-mode="Ignore" class="settings-volume-value" />
        </ui:VisualElement>
        <ui:VisualElement class="settings-control-row settings-music-row">
          <ui:Label text="音乐音量" class="settings-control-label" />
          <ui:VisualElement class="settings-slider-shell">
            <ui:VisualElement name="music-volume-fill" picking-mode="Ignore" class="settings-slider-fill-clip">
              <ui:VisualElement picking-mode="Ignore" class="settings-slider-fill-art" />
            </ui:VisualElement>
            <ui:Slider name="music-volume-slider" low-value="0" high-value="100" value="100" class="settings-slider" />
          </ui:VisualElement>
          <ui:Label name="music-volume-value" text="100%" picking-mode="Ignore" class="settings-volume-value" />
        </ui:VisualElement>
        <ui:VisualElement class="settings-control-row settings-sound-row">
          <ui:Label text="音效音量" class="settings-control-label" />
          <ui:VisualElement class="settings-slider-shell">
            <ui:VisualElement name="sound-volume-fill" picking-mode="Ignore" class="settings-slider-fill-clip">
              <ui:VisualElement picking-mode="Ignore" class="settings-slider-fill-art" />
            </ui:VisualElement>
            <ui:Slider name="sound-volume-slider" low-value="0" high-value="100" value="100" class="settings-slider" />
          </ui:VisualElement>
          <ui:Label name="sound-volume-value" text="100%" picking-mode="Ignore" class="settings-volume-value" />
        </ui:VisualElement>
        <ui:VisualElement class="settings-section-row settings-display-section">
          <ui:Label text="显示" class="settings-section-title" />
          <ui:VisualElement picking-mode="Ignore" class="settings-section-line" />
        </ui:VisualElement>
        <ui:VisualElement class="settings-control-row settings-toggle-row">
          <ui:Label text="全屏显示" class="settings-control-label" />
          <ui:Toggle name="fullscreen-toggle" value="true" class="settings-toggle" />
        </ui:VisualElement>
        <ui:VisualElement class="utility-actions">
          <ui:Button name="settings-debug-button" text="开发者配置" class="action-button secondary-action settings-debug-button" />
          <ui:Button name="settings-reset-button" text="恢复默认" class="action-button secondary-action" />
          <ui:Button name="settings-close-button" text="返回" class="action-button primary-action" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="help-overlay" class="overlay utility-overlay" style="display: none;">
      <ui:VisualElement name="help-panel" class="utility-panel help-panel">
        <ui:VisualElement class="settings-title-row help-title-row">
          <ui:VisualElement picking-mode="Ignore" class="settings-title-line" />
          <ui:Label text="规则帮助" class="utility-title help-title" />
          <ui:VisualElement picking-mode="Ignore" class="settings-title-line" />
        </ui:VisualElement>
        <ui:ScrollView class="help-scroll">
          <ui:Label text="目标" class="help-heading" />
          <ui:Label text="摧毁敌方的家即可获胜；自己的家被摧毁则失败。" class="help-copy" />
          <ui:Label text="你的回合" class="help-heading" />
          <ui:Label text="从手牌部署卡牌，选择己方单位后移动、攻击或互换。界面高亮的格子才是当前合法目标。" class="help-copy" />
          <ui:Label text="资源与行动" class="help-heading" />
          <ui:Label text="资源卡和家会提供资源；单位维持费不足时，本回合无法行动。刚部署的单位可能受到召唤失调限制。" class="help-copy" />
          <ui:Label text="结束回合" class="help-heading" />
          <ui:Label text="完成操作后点击顶部中央按钮结束回合。若手牌超过上限，需要先弃牌。" class="help-copy" />
        </ui:ScrollView>
        <ui:Button name="help-close-button" text="明白了" class="action-button primary-action utility-close-button" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="debug-panel" class="cfg-mask">
      <ui:VisualElement class="cfg-panel">
        <ui:VisualElement class="cfg-head">
          <ui:VisualElement class="cfg-head-top">
            <ui:Label text="⚙ 对局配置" class="cfg-title" />
            <ui:VisualElement class="cfg-head-actions">
              <ui:Button name="debug-reset-button" text="恢复默认" />
              <ui:Button name="debug-close-button" text="关闭" />
              <ui:Button name="debug-apply-button" text="应用并重开" class="primary" />
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:Label name="debug-error" class="cfg-error" />
        </ui:VisualElement>
        <ui:VisualElement class="cfg-body">
          <ui:ScrollView name="debug-scroll" mode="Vertical" class="cfg-scroll">
            <ui:Label text="修改仅在“应用并重开”后生效。关闭后保留草稿，重新打开可继续编辑。" class="cfg-note" />
            <ui:VisualElement name="debug-board" />
            <ui:VisualElement name="debug-home" />
            <ui:VisualElement name="debug-deck" />
            <ui:VisualElement name="debug-cards" />
            <ui:VisualElement name="debug-boss" />
            <ui:VisualElement name="debug-turn" />
            <ui:VisualElement name="debug-toggles" />
            <ui:VisualElement class="cfg-section">
              <ui:Label text="JSON 导入 / 导出" class="cfg-section-title" />
              <ui:Label text="复制完整配置 JSON 后可粘贴到文本文件保存。导入前请先复制文件中的全部 JSON；导入只修改草稿，应用并重开后生效。" class="cfg-note" />
              <ui:VisualElement class="cfg-json-actions">
                <ui:Button name="debug-export-button" text="复制 JSON" />
                <ui:Button name="debug-import-button" text="从剪贴板导入" />
              </ui:VisualElement>
              <ui:Label name="debug-json-status" class="cfg-note" />
            </ui:VisualElement>
          </ui:ScrollView>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
